{
    "chat.tools.terminal.autoApprove": {
        "python -m pytest": true,
        "python -m ollama_copilot_fixer": true,
        "ollama": true
    },
    "github.copilot.chat.agentDebugLog.fileLogging.enabled": true,

    // GitHub Copilot LLM Gateway — connects Copilot Chat to your local llama-server
    "github.copilot.llm-gateway.serverUrl": "http://127.0.0.1:8080",
    "github.copilot.llm-gateway.requestTimeout": 600000,
    "github.copilot.llm-gateway.defaultMaxTokens": 16384,
    "github.copilot.llm-gateway.defaultMaxOutputTokens": 4096,
    "github.copilot.llm-gateway.enableToolCalling": true,
    "github.copilot.llm-gateway.parallelToolCalling": false,
    "github.copilot.llm-gateway.agentTemperature": 0.0,

    // Keep local-agent context lean and predictable.
    "github.copilot.chat.skillTool.enabled": true,
    "github.copilot.chat.summarizeAgentConversationHistory.enabled": true,
    "chat.useCustomizationsInParentRepositories": false,

    "search.exclude": {
        "**/logs/**": true,
        "**/models/**": true,
        "**/tools/ik_llama.cpp/**": true,
        "**/tools/llama.cpp/**": true
    },
    "files.watcherExclude": {
        "**/logs/**": true,
        "**/models/**": true,
        "**/tools/ik_llama.cpp/**": true,
        "**/tools/llama.cpp/**": true
    }
}